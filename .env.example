# =============================================
# Настройки базы данных
# =============================================
DB_HOST=localhost
DB_NAME=название_базы
DB_USER=пользователь_базы
DB_PASS=пароль_базы
DB_PORT=3306

# =============================================
# Настройки сайта
# =============================================
SITE_URL=https://ваш-домен.ru/папка/
ENVIRONMENT=production   # development | production

# =============================================
# Инструкция
# =============================================
# 1. Скопируйте этот файл в .env
#    cp .env.example .env
# 2. Заполните реальными значениями
# 3. .env НЕ добавляйте в Git (он уже в .gitignore)